{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fichier d'exercices DevForge (tracks/<parcours>/n<niveau>/*.yaml)",
  "type": "object",
  "required": ["exercises"],
  "additionalProperties": false,
  "properties": {
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "lineNumbers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "choice": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+$" },
        "text": { "$ref": "#/$defs/text" },
        "correct": { "type": "boolean" },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "blank": {
      "type": "object",
      "required": ["answers"],
      "additionalProperties": false,
      "properties": {
        "answers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "options": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "issue": {
      "type": "object",
      "required": ["lines", "category", "description"],
      "additionalProperties": false,
      "properties": {
        "lines": { "$ref": "#/$defs/lineNumbers" },
        "category": { "enum": ["bug", "securite", "performance", "lisibilite", "conception", "test"] },
        "description": { "$ref": "#/$defs/text" }
      }
    },
    "node": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "ending": { "enum": ["success", "partial", "failure"] },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "next"],
            "additionalProperties": false,
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "next": { "type": "string" },
              "points": { "type": "integer", "minimum": 0 },
              "feedback": { "$ref": "#/$defs/text" }
            }
          }
        }
      },
      "oneOf": [
        { "required": ["ending"], "not": { "required": ["options"] } },
        { "required": ["options"], "not": { "required": ["ending"] } }
      ]
    },
    "criterion": {
      "type": "object",
      "required": ["criterion", "points"],
      "additionalProperties": false,
      "properties": {
        "criterion": { "$ref": "#/$defs/text" },
        "points": { "type": "integer", "minimum": 1 },
        "hint": { "$ref": "#/$defs/text" }
      }
    },
    "exercise": {
      "type": "object",
      "required": ["id", "type", "title", "skills", "difficulty", "prompt", "explanation"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
        "type": {
          "enum": [
            "qcm", "predict-output", "find-bug", "parsons", "fill-blanks",
            "match", "code-review", "scenario", "design-challenge", "code"
          ]
        },
        "title": { "$ref": "#/$defs/text" },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "xp": { "type": "integer", "minimum": 1 },
        "language": { "enum": ["kotlin", "java", "python", "bash", "dockerfile", "yaml", "sql", "text"] },
        "prompt": { "$ref": "#/$defs/text" },
        "code": { "$ref": "#/$defs/text" },
        "hints": { "$ref": "#/$defs/texts" },
        "explanation": { "$ref": "#/$defs/text" },
        "tags": { "$ref": "#/$defs/texts" },

        "choices": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/choice" } },
        "multiple": { "type": "boolean" },
        "expected_output": { "type": "string" },
        "bug_lines": { "$ref": "#/$defs/lineNumbers" },
        "lines": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "distractors": { "type": "array", "items": { "type": "string" } },
        "blanks": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/blank" }
        },
        "pairs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "additionalProperties": false,
            "properties": {
              "left": { "$ref": "#/$defs/text" },
              "right": { "$ref": "#/$defs/text" }
            }
          }
        },
        "issues": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/issue" } },
        "min_found": { "type": "integer", "minimum": 1 },
        "start": { "type": "string" },
        "nodes": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "$ref": "#/$defs/node" }
        },
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "constraints": { "$ref": "#/$defs/texts" },
        "rubric": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/criterion" } },
        "reference_solution": { "$ref": "#/$defs/text" },
        "starter_code": { "type": "string" },
        "tests": { "$ref": "#/$defs/text" },
        "solution": { "$ref": "#/$defs/text" },
        "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "qcm" } } },
          "then": { "required": ["choices"] }
        },
        {
          "if": { "properties": { "type": { "const": "predict-output" } } },
          "then": {
            "required": ["code"],
            "anyOf": [{ "required": ["choices"] }, { "required": ["expected_output"] }]
          }
        },
        {
          "if": { "properties": { "type": { "const": "find-bug" } } },
          "then": { "required": ["code", "bug_lines"] }
        },
        {
          "if": { "properties": { "type": { "const": "parsons" } } },
          "then": { "required": ["lines"] }
        },
        {
          "if": { "properties": { "type": { "const": "fill-blanks" } } },
          "then": { "required": ["code", "blanks"] }
        },
        {
          "if": { "properties": { "type": { "const": "match" } } },
          "then": { "required": ["pairs"] }
        },
        {
          "if": { "properties": { "type": { "const": "code-review" } } },
          "then": { "required": ["code", "issues"] }
        },
        {
          "if": { "properties": { "type": { "const": "scenario" } } },
          "then": { "required": ["start", "nodes"] }
        },
        {
          "if": { "properties": { "type": { "const": "design-challenge" } } },
          "then": { "required": ["requirements", "rubric", "reference_solution"] }
        },
        {
          "if": { "properties": { "type": { "const": "code" } } },
          "then": { "required": ["language", "starter_code", "tests", "solution"] }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parcours DevForge (tracks/<parcours>/track.yaml)",
  "type": "object",
  "required": ["id", "title", "description", "levels"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/level" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "level": {
      "type": "object",
      "required": ["level", "title", "skills"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 5 },
        "title": { "type": "string", "minLength": 1 },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/slug" },
              "title": { "type": "string", "minLength": 1 }
            }
          }
        },
        "boss": {
          "type": "object",
          "required": ["id", "title", "exercises", "pass_ratio"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
            "title": { "type": "string", "minLength": 1 },
            "exercises": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "pass_ratio": { "type": "number", "minimum": 0.5, "maximum": 1 },
            "time_limit_min": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
